# ==============================================================================
# Environment Configuration Template: Customer Sentiment Engine
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your active '.env' file to Git.
# ==============================================================================

# --- AWS S3 CREDENTIALS & STORAGE ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_RAW_BUCKET_NAME=your-feedback-raw-landing-bucket

# --- SNOWFLAKE CREDENTIALS & WORKSPACE ---
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier  # Format: orgname-accountname or account_id.region
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USERNAME
SNOWFLAKE_PASSWORD=YOUR_SNOWFLAKE_PASSWORD
SNOWFLAKE_ROLE=ACCOUNTADMIN                          # Role with privilege to execute Cortex AI and create database/stages
SNOWFLAKE_WAREHOUSE=COMPUTE_WH                      # Compute engine for executions
SNOWFLAKE_DATABASE=CUSTOMER_FEEDBACK_DB              # Target analytics database
SNOWFLAKE_SCHEMA=RAW                                # Landing schema for raw logs
